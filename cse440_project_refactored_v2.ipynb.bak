    "    lambda units, rdrop: SimpleRNN(units, recurrent_dropout=rdrop),\n",
    "    simplernn_configs, X_train_seq, y_train, X_val_seq, y_val,\n",
    "    tuning_log, best_models, class_weight=class_weights_dict,\n",
    ")"
