  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### GloVe Embeddings Download\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-20T14:09:25.863932Z",
     "iopub.status.busy": "2026-08-20T14:09:25.863724Z",
     "iopub.status.idle": "2026-08-20T14:09:25.868019Z",
     "shell.execute_reply": "2026-08-20T14:09:25.867550Z"
    }
   },
   "outputs": [],
   "source": [
    "glove_url = \"https://nlp.stanford.edu/data/glove.6B.zip\"\n",
    "zip_path = \"data/glove.6B.zip\"\n",
    "extract_path = \"data/\"\n",
    "glove_file = \"data/glove.6B.100d.txt\" \n",
    "\n",
    "os.makedirs(extract_path, exist_ok=True)\n",
    "\n",
    "if not os.path.exists(glove_file):\n",
    "    print(\"Downloading GloVe embeddings \")\n",
    "    urllib.request.urlretrieve(glove_url, zip_path)\n",
    "    print(\"Download complete.\")\n",
    "    \n",
    "    with zipfile.ZipFile(zip_path, 'r') as zip_ref:\n",
    "        zip_ref.extractall(extract_path)\n",
    "    \n",
    "    os.remove(zip_path)\n",
    "    print(\"Extraction complete.\")\n",
    "else:\n",
    "    print(\"GloVe file already exists.\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### GloVe Word Vectors Loading\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "EMBEDDING_DIM = 100\n",
    "embeddings_index = {}\n",
    "\n",
    "with open(glove_file, 'r', encoding='utf-8') as f:\n",
    "    for line in f:\n",
    "        values = line.split()\n",
    "        word = values[0]\n",
    "        coefs = np.asarray(values[1:], dtype='float32')\n",
    "        embeddings_index[word] = coefs\n",
    "\n",
    "print(f\"Found {len(embeddings_index)} word vectors in GloVe.\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Pretrained Embedding Matrix Construction\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "word_index = tokenizer.word_index\n",
    "embedding_matrix = np.zeros((MAX_WORDS, EMBEDDING_DIM))\n",
    "\n",
    "for word, i in word_index.items():\n",
    "    if i < MAX_WORDS:\n",
    "        embedding_vector = embeddings_index.get(word)\n",
    "        if embedding_vector is not None:\n",
    "            embedding_matrix[i] = embedding_vector\n",
    "\n",
    "print(\"Embedding matrix shape:\", embedding_matrix.shape)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 5. Model Development & Hyperparameter Tuning\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Hyperparameter Tuning Log Initialization\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "tuning_log = pd.DataFrame(columns=['Model', 'Config', 'Val F1'])\n",
    "\n",
    "best_models = {}\n",
    "\n",
    "# Per-architecture hyperparameter grids (3 configs each, as required).\n",
    "# These are intentionally NOT identical across architectures:\n",
    "#   - SimpleRNN is prone to vanishing/exploding gradients over longer\n",
    "#     sequences, so it gets a lower learning-rate option instead of a\n",
    "#     capacity increase.\n",
    "#   - GRU/LSTM get a wider capacity sweep (32 -> 128 units) since gating\n",
    "#     lets them exploit extra capacity without the same instability.\n",
    "#   - Bidirectional variants concatenate a forward and backward pass, which\n",
    "#     roughly doubles parameter count for the same `units` value. Their\n",
    "#     `units` are halved relative to the unidirectional GRU/LSTM sweep and\n",
    "#     dropout is raised slightly, so the sweep isolates the effect of\n",
    "#     bidirectionality rather than confounding it with a capacity increase.\n",
    "simplernn_configs = [\n",
    "    {'units': 32, 'dropout': 0.2, 'lr': 0.001,  'trainable_emb': False},\n",
    "    {'units': 64, 'dropout': 0.3, 'lr': 0.0005, 'trainable_emb': False},\n",
    "    {'units': 96, 'dropout': 0.4, 'lr': 0.0005, 'trainable_emb': True},\n",
    "]\n",
    "\n",
    "gru_configs = [\n",
    "    {'units': 32,  'dropout': 0.2, 'lr': 0.001, 'trainable_emb': False},\n",
    "    {'units': 64,  'dropout': 0.3, 'lr': 0.001, 'trainable_emb': False},\n",
    "    {'units': 128, 'dropout': 0.4, 'lr': 0.001, 'trainable_emb': True},\n",
    "]\n",
    "\n",
    "lstm_configs = [\n",
    "    {'units': 32,  'dropout': 0.2, 'lr': 0.001, 'trainable_emb': False},\n",
    "    {'units': 64,  'dropout': 0.3, 'lr': 0.001, 'trainable_emb': False},\n",
    "    {'units': 128, 'dropout': 0.4, 'lr': 0.001, 'trainable_emb': True},\n",
    "]\n",
    "\n",
    "bi_simplernn_configs = [\n",
    "    {'units': 16, 'dropout': 0.3, 'lr': 0.001,  'trainable_emb': False},\n",
    "    {'units': 32, 'dropout': 0.4, 'lr': 0.0005, 'trainable_emb': False},\n",
    "    {'units': 48, 'dropout': 0.4, 'lr': 0.0005, 'trainable_emb': True},\n",
    "]\n",
    "\n",
    "bi_gru_configs = [\n",
    "    {'units': 16, 'dropout': 0.3, 'lr': 0.001, 'trainable_emb': False},\n",
    "    {'units': 32, 'dropout': 0.4, 'lr': 0.001, 'trainable_emb': False},\n",
    "    {'units': 64, 'dropout': 0.4, 'lr': 0.001, 'trainable_emb': True},\n",
    "]\n",
    "\n",
    "bi_lstm_configs = [\n",
    "    {'units': 16, 'dropout': 0.3, 'lr': 0.001, 'trainable_emb': False},\n",
    "    {'units': 32, 'dropout': 0.4, 'lr': 0.001, 'trainable_emb': False},\n",
    "    {'units': 64, 'dropout': 0.4, 'lr': 0.001, 'trainable_emb': True},\n",
    "]"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Target Variable Arrays Extraction\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "y_train = train_df['target']\n",
    "y_val = val_df['target']\n",
    "y_test = test_df['target']\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Shared Traditional ML Tuning Utility"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import joblib\n",
    "\n",
    "os.makedirs('models', exist_ok=True)\n",
    "\n",
    "\n",
    "def tune_sklearn_model(model_name, model_fn, configs, X_train, y_train, X_val, y_val,\n",
    "                        tuning_log, config_str_fn=None, save_dir='models'):\n",
    "    \"\"\"\n",
    "    Trains one sklearn estimator per entry in configs, logs validation macro F1\n",
    "    to tuning_log, saves every trained model to disk, and returns the best model.\n",
    "    \"\"\"\n",
    "    best_f1 = -1\n",
    "    best_model = None\n",
    "\n",
    "    for config in configs:\n",
    "        if config_str_fn is not None:\n",
    "            config_str = config_str_fn(config)\n",
    "        else:\n",
    "            config_str = \", \".join(f\"{k}={v}\" for k, v in config.items())\n",
    "\n",
    "        model = model_fn(config)\n",
    "        model.fit(X_train, y_train)\n",
    "\n",
    "        val_preds = model.predict(X_val)\n",
    "        val_macro_f1 = f1_score(y_val, val_preds, average='macro')\n",
    "\n",
    "        tuning_log.loc[len(tuning_log)] = [model_name, config_str, val_macro_f1]\n",
    "\n",
    "        safe_name = model_name.replace(' ', '_')\n",
    "        config_tag = \"_\".join(f\"{k}{v}\" for k, v in config.items())\n",
    "        joblib.dump(model, f\"{save_dir}/{safe_name}_{config_tag}.joblib\")\n",
    "\n",
    "        if val_macro_f1 > best_f1:\n",
    "            best_f1 = val_macro_f1\n",
    "            best_model = model\n",
    "\n",
    "    display_df = tuning_log[tuning_log['Model'] == model_name]\n",
    "    display(display_df[['Model', 'Config', 'Val F1']])\n",
    "\n",
    "    return best_model\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Naive Bayes Classifier Tuning"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Sweep the Laplace smoothing strength (alpha) and whether class priors are\n",
    "# learned from the (imbalanced) training distribution or treated as uniform.\n",
    "# MultinomialNB has no class_weight option, so fit_prior=False is the NB\n",
    "# equivalent of \"balanced\" -- it stops the model from just favoring whichever\n",
    "# class is most frequent in y_train.\n",
    "nb_configs = [\n",
    "    {'alpha': 0.1, 'fit_prior': True},\n",
    "    {'alpha': 0.5, 'fit_prior': True},\n",
    "    {'alpha': 1.0, 'fit_prior': False},\n",
    "]\n",
    "\n",
    "nb_model = tune_sklearn_model(\n",
    "    'Naive Bayes',\n",
    "    lambda cfg: MultinomialNB(alpha=cfg['alpha'], fit_prior=cfg['fit_prior']),\n",
    "    nb_configs, X_train_tfidf, y_train, X_val_tfidf, y_val, tuning_log,\n",
    "    config_str_fn=lambda cfg: f\"alpha={cfg['alpha']}, fit_prior={cfg['fit_prior']}\",\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Logistic Regression Classifier Tuning"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Sweep inverse regularization strength C AND penalty type, with\n",
    "# class_weight='balanced' throughout since macro F1 is the selection metric\n",
    "# and classes are not perfectly balanced.\n",
    "# - L2 (lbfgs) configs sweep how strongly the model is regularized.\n",
    "# - The L1 (liblinear) config drives many of the 8000 TF-IDF weights to\n",
    "#   exactly zero, which acts as built-in feature selection on a\n",
    "#   high-dimensional sparse bag-of-words representation and is worth\n",
    "#   comparing directly against pure L2.\n",
    "lr_configs = [\n",
    "    {'C': 0.1,  'penalty': 'l2', 'solver': 'lbfgs'},\n",
    "    {'C': 1.0,  'penalty': 'l2', 'solver': 'lbfgs'},\n",
    "    {'C': 10.0, 'penalty': 'l2', 'solver': 'lbfgs'},\n",
    "    {'C': 1.0,  'penalty': 'l1', 'solver': 'liblinear'},\n",
    "]\n",
    "\n",
    "lr_model = tune_sklearn_model(\n",
    "    'Logistic Regression',\n",
    "    lambda cfg: LogisticRegression(\n",
    "        C=cfg['C'],\n",
    "        penalty=cfg['penalty'],\n",
    "        solver=cfg['solver'],\n",
    "        max_iter=2000,\n",
    "        class_weight='balanced',\n",
    "        random_state=42,\n",
    "    ),\n",
    "    lr_configs, X_train_tfidf, y_train, X_val_tfidf, y_val, tuning_log,\n",
    "    config_str_fn=lambda cfg: (\n",
    "        f\"C={cfg['C']}, penalty={cfg['penalty']}, solver={cfg['solver']}, \"\n",
    "        f\"max_iter=2000, class_weight=balanced\"\n",
    "    ),\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Random Forest Classifier Tuning"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Sweep n_estimators, max_depth, min_samples_leaf, AND max_features jointly.\n",
    "# class_weight='balanced' fixed across all configs.\n",
    "#\n",
    "# The previous grid capped max_depth at 30-50 for every config. On sparse,\n",
    "# high-dimensional TF-IDF text features, unnecessarily bounding tree depth\n",
    "# usually hurts a random forest more than it helps -- min_samples_leaf and\n",
    "# the ensemble averaging already provide regularization, so an unbounded\n",
    "# depth is included and compared directly against a bounded one instead of\n",
    "# assumed to be worse. n_estimators is also raised (200-300) since text\n",
    "# ensembles typically keep improving up to a few hundred trees before\n",
    "# diminishing returns, and n_jobs=-1 keeps the extra trees cheap.\n",
    "rf_configs = [\n",
    "    {'n_estimators': 200, 'max_depth': None, 'min_samples_leaf': 2, 'max_features': 'sqrt'},\n",
    "    {'n_estimators': 300, 'max_depth': 50,   'min_samples_leaf': 2, 'max_features': 'sqrt'},\n",
    "    {'n_estimators': 300, 'max_depth': None, 'min_samples_leaf': 4, 'max_features': 'log2'},\n",
    "]\n",
    "\n",
    "rf_model = tune_sklearn_model(\n",
    "    'Random Forest',\n",
    "    lambda cfg: RandomForestClassifier(\n",
    "        n_estimators=cfg['n_estimators'],\n",
    "        max_depth=cfg['max_depth'],\n",
    "        min_samples_leaf=cfg['min_samples_leaf'],\n",
    "        max_features=cfg['max_features'],\n",
    "        class_weight='balanced',\n",
    "        random_state=42,\n",
    "        n_jobs=-1,\n",
    "    ),\n",
    "    rf_configs, X_train_tfidf, y_train, X_val_tfidf, y_val, tuning_log,\n",
    "    config_str_fn=lambda cfg: (\n",
    "        f\"n_est={cfg['n_estimators']}, max_depth={cfg['max_depth']}, \"\n",
    "        f\"min_samples_leaf={cfg['min_samples_leaf']}, max_features={cfg['max_features']}, \"\n",
    "        f\"class_weight=balanced\"\n",
    "    ),\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Shared RNN Training Utilities (seeding, model builder, training loop)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.utils.class_weight import compute_class_weight\n",
    "import random\n",
    "\n",
    "\n",
    "def set_global_seed(seed=42):\n",
    "    \"\"\"Seed python, numpy, and TensorFlow so training runs are reproducible.\"\"\"\n",
    "    random.seed(seed)\n",
    "    np.random.seed(seed)\n",
    "    tf.random.set_seed(seed)\n",
    "\n",
    "\n",
    "def build_rnn_model(rnn_layer_fn, config, vocab_size=MAX_WORDS, embedding_dim=EMBEDDING_DIM,\n",
    "                     embedding_matrix=embedding_matrix, num_classes=4,\n",
    "                     recurrent_dropout=0.0, clipnorm=1.0):\n",
    "    \"\"\"\n",
    "    rnn_layer_fn: callable(units, recurrent_dropout) -> a Keras recurrent layer, e.g.\n",
    "                  lambda units, rdrop: GRU(units, recurrent_dropout=rdrop)\n",
    "                  lambda units, rdrop: Bidirectional(LSTM(units, recurrent_dropout=rdrop))\n",
    "    config: dict with 'units', 'dropout', 'lr', and optionally 'trainable_emb'\n",
    "\n",
    "    Note: recurrent_dropout > 0 disables the fused cuDNN kernel for GRU/LSTM on GPU,\n",
    "    which trades some training speed for better regularization. Set recurrent_dropout=0.0\n",
    "    if you need maximum GPU throughput.\n",
    "    \"\"\"\n",
    "    model = Sequential([\n",
    "        Embedding(\n",
    "            input_dim=vocab_size,\n",
    "            output_dim=embedding_dim,\n",
    "            weights=[embedding_matrix],\n",
    "            trainable=config.get('trainable_emb', False),\n",
    "            mask_zero=True,  # ignore padding tokens instead of feeding them through the RNN\n",
    "        ),\n",
    "        rnn_layer_fn(config['units'], recurrent_dropout),\n",
    "        Dropout(config['dropout']),\n",
    "        # Hidden Dense layer between the recurrent output and the softmax head.\n",
    "        # Going straight from the RNN's pooled state to a 4-way softmax gives the\n",
    "        # classifier very little room to recombine the recurrent features; a small\n",
    "        # ReLU hidden layer lets it learn non-linear combinations of them first.\n",
    "        Dense(max(config['units'], 16), activation='relu'),\n",
    "        Dropout(config['dropout'] / 2),\n",
    "        Dense(num_classes, activation='softmax'),\n",
    "    ])\n",
    "\n",
    "    optimizer = tf.keras.optimizers.Adam(learning_rate=config['lr'], clipnorm=clipnorm)\n",
    "    model.compile(optimizer=optimizer, loss='sparse_categorical_crossentropy', metrics=['accuracy'])\n",
    "    return model\n",
    "\n",
    "\n",
    "def train_rnn_config(model_name, rnn_layer_fn, config, X_train_seq, y_train, X_val_seq, y_val,\n",
    "                      tuning_log, class_weight=None, recurrent_dropout=0.0, clipnorm=1.0,\n",
    "                      epochs=10, batch_size=64, save_dir='models', seed=42):\n",
    "    \"\"\"Trains one (architecture, config) pair, logs its val macro F1, saves the model to disk.\"\"\"\n",
    "    set_global_seed(seed)\n",
    "\n",
    "    trainable_emb = config.get('trainable_emb', False)\n",
    "    config_str = (f\"units={config['units']}, dropout={config['dropout']}, \"\n",
    "                  f\"lr={config['lr']}, unfrozen_emb={trainable_emb}, \"\n",
    "                  f\"recurrent_dropout={recurrent_dropout}\")\n",
    "\n",
    "    model = build_rnn_model(rnn_layer_fn, config, recurrent_dropout=recurrent_dropout, clipnorm=clipnorm)\n",
    "\n",
    "    callbacks = [\n",
    "        EarlyStopping(monitor='val_loss', patience=3, restore_best_weights=True),\n",
    "        tf.keras.callbacks.ReduceLROnPlateau(monitor='val_loss', patience=2, factor=0.5),\n",
    "    ]\n",
    "\n",
    "    history = model.fit(\n",
    "        X_train_seq, y_train,\n",
    "        validation_data=(X_val_seq, y_val),\n",
    "        epochs=epochs,\n",
    "        batch_size=batch_size,\n",
    "        callbacks=callbacks,\n",
    "        class_weight=class_weight,\n",
    "        verbose=0,\n",
    "    )\n",
    "\n",
    "    val_probs = model.predict(X_val_seq, verbose=0)\n",
    "    val_preds = np.argmax(val_probs, axis=1)\n",
    "    val_macro_f1 = f1_score(y_val, val_preds, average='macro')\n",
    "\n",
    "    tuning_log.loc[len(tuning_log)] = [model_name, config_str, val_macro_f1]\n",
    "\n",
    "    os.makedirs(save_dir, exist_ok=True)\n",
    "    safe_name = model_name.replace(' ', '_')\n",
    "    model_path = f\"{save_dir}/{safe_name}_u{config['units']}_do{config['dropout']}_lr{config['lr']}.keras\"\n",
    "    model.save(model_path)\n",
    "\n",
    "    return model, history, val_macro_f1\n",
    "\n",
    "\n",
    "def run_architecture_sweep(model_name, rnn_layer_fn, configs, X_train_seq, y_train, X_val_seq, y_val,\n",
    "                            tuning_log, best_models, class_weight=None, recurrent_dropout=0.0,\n",
    "                            save_dir='models'):\n",
    "    \"\"\"Runs every config for one architecture, keeps the best model by val macro F1.\"\"\"\n",
    "    best_f1 = -1\n",
    "    best_model = None\n",
    "    histories = []\n",
    "\n",
    "    for config in configs:\n",
    "        model, history, val_macro_f1 = train_rnn_config(\n",
    "            model_name, rnn_layer_fn, config,\n",
    "            X_train_seq, y_train, X_val_seq, y_val,\n",
    "            tuning_log, class_weight=class_weight,\n",
    "            recurrent_dropout=recurrent_dropout, save_dir=save_dir,\n",
    "        )\n",
    "        histories.append(history)\n",
    "\n",
    "        if val_macro_f1 > best_f1:\n",
    "            best_f1 = val_macro_f1\n",
    "            best_model = model\n",
    "\n",
    "    best_models[model_name] = best_model\n",
    "\n",
    "    display_df = tuning_log[tuning_log['Model'] == model_name]\n",
    "    display(display_df[['Model', 'Config', 'Val F1']])\n",
    "\n",
    "    return histories\n",
    "\n",
    "\n",
    "# Global setup shared by every architecture sweep below\n",
    "set_global_seed(42)\n",
    "\n",
    "class_weights_arr = compute_class_weight(class_weight='balanced', classes=np.unique(y_train), y=y_train)\n",
    "class_weights_dict = dict(enumerate(class_weights_arr))\n",
    "print(\"Class weights:\", class_weights_dict)\n",
    "\n",
    "os.makedirs('models', exist_ok=True)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
