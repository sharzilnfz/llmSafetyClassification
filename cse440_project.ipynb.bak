    ")\n",
    "\n",
    "trigram_counts = X.sum(axis=0).A1\n",
    "\n",
    "trigrams = pd.DataFrame({\n",
    "    \"trigram\": vectorizer.get_feature_names_out(),\n",
    "    \"count\": trigram_counts\n",
    "})\n",
    "\n",
    "trigrams = trigrams.sort_values(\n",
    "    \"count\",\n",
