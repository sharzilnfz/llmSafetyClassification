   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 3. Data Pre-Processing"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Text Cleaning & Empty Prompt Removal"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 28,
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-13T15:05:11.778152Z",
     "iopub.status.busy": "2026-08-13T15:05:11.777989Z",
     "iopub.status.idle": "2026-08-13T15:05:13.384794Z",
     "shell.execute_reply": "2026-08-13T15:05:13.384069Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Cleaned Full Train Shape (All Prompts Retained): (86745, 7)\n",
      "Cleaned Full Test Shape (All Prompts Retained): (1699, 7)\n"
     ]
    }
   ],
   "source": [
    "import re\n",
    "\n",
    "def clean_text(text):\n",
    "    if not isinstance(text, str):\n",
    "        return \"\"\n",
    "    text = text.lower()\n",
    "    text = re.sub(r'https?://\\S+|www\\.\\S+', '', text)\n",
    "    text = re.sub(r'\\s+', ' ', text).strip()\n",
    "    return text\n",
    "\n",
    "# Apply standardized cleaning while preserving all prompts and adversarial/jailbreak syntax\n",
    "train_df['clean_prompt'] = train_df['prompt'].apply(clean_text)\n",
    "test_df['clean_prompt'] = test_df['prompt'].apply(clean_text)\n",
    "\n",
    "# Remove only unprocessable empty prompts (14 rows in raw train data)\n",
    "train_df = train_df[train_df['clean_prompt'] != ''].copy()\n",
    "test_df = test_df[test_df['clean_prompt'] != ''].copy()\n",
    "\n",
    "print(\"Cleaned Full Train Shape (All Prompts Retained):\", train_df.shape)\n",
    "print(\"Cleaned Full Test Shape (All Prompts Retained):\", test_df.shape)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Stratified Train / Validation / Test Split"
