    "train_df['prompt'].astype(str)\n",
    ".str.split()\n",
    ".str.len()\n",
    ")\n",
    "train_df[\"sentence_count\"] = (\n",
    "train_df['prompt'].astype(str)\n",
    ".str.split(r'[.!?]+')\n",
    ")\n",
    "train_df[\n",
    "    [\"char_count\", \"word_count\", \"sentence_count\"]\n",
    "].describe()\n",
    "\n"
   ]
