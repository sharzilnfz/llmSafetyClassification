    "clean_text = (\n",
    "    train_df[\"prompt\"]\n",
    "    .astype(str)\n",
    "    .str.lower()\n",
    "    .str.replace(r\"[^\\w\\s]\", \"\", regex=True)\n",
    ")\n",
    "\n",
    "clean_words = \" \".join(clean_text).split()\n",
    "\n",
    "word_counts = Counter(clean_words)\n",
    "\n",
    "word_counts.most_common(30)"
   ]
  },
