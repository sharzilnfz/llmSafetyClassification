   "source": [
    "#Stopwords removal\n",
    "stop_words = set(\n",
    "    stopwords.words(\"english\")\n",
    ")\n",
    "\n",
    "words_without_stopwords = [\n",
    "    word\n",
    "    for word in clean_words\n",
    "    if word not in stop_words\n",
    "]\n",
    "\n",
    "filtered_word_counts = Counter(\n",
    "    words_without_stopwords\n",
    ")\n",
    "\n",
    "filtered_word_counts.most_common(30)"
   ]
  },
