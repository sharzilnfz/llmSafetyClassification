    "#Top 20 words\n",
    "top_words = word_counts.most_common(20)\n",
    "\n",
    "words = [item[0] for item in top_words]\n",
    "counts = [item[1] for item in top_words]\n",
    "\n",
    "plt.figure(figsize=(12, 7))\n",
    "\n",
    "sns.barplot(\n",
    "    x=counts,\n",
    "    y=words\n",
    ")\n",
    "\n",
    "plt.title(\"Top 20 Most Frequent Words\")\n",
    "plt.xlabel(\"Frequency\")\n",
    "plt.ylabel(\"Word\")\n",
    "\n",
    "plt.show()"
   ]
